<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cn.jianji.app" android:versionCode="4" android:versionName="1.3.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:label="简记" android:theme="@style/AppTheme" android:icon="@drawable/ic_launcher" android:roundIcon="@drawable/ic_launcher" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".EntryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SubscriptionActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <receiver android:name=".SubscriptionReceiver" android:exported="false">
            <intent-filter>
